{
  "expo": {
    "name": "QuickG76",
    "slug": "QuickG76",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "description": "Kalkulator G-Code G76 untuk CNC Threading",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickg76.app"
    },
    "android": {
      "package": "com.quickg76.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "QuickG76",
      "shortName": "QuickG76",
      "description": "Kalkulator G-Code G76 untuk CNC Threading",
      "themeColor": "#0969DA",
      "backgroundColor": "#F0F2F5",
      "scope": "/",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "portrait",
      "barStyle": "default"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
